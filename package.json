{
  "name": "opensafari-mcp",
  "version": "0.1.7",
  "description": "iOS Safari automation MCP server via Xcode Simulator + WebKit Remote Debugging Protocol",
  "main": "dist/index.js",
  "bin": {
    "opensafari": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:src && npm run build:cli",
    "build:src": "webpack --config webpack.config.js --config-name server",
    "build:cli": "webpack --config webpack.config.js --config-name cli",
    "clean": "rimraf dist",
    "dev": "ts-node --esm src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js",
    "test:integration": "jest --preset ts-jest --testEnvironment node --roots tests/integration --testPathIgnorePatterns '/node_modules/' --testPathIgnorePatterns 'webkit-connection' --testTimeout=120000 --runInBand",
    "test:ci": "jest --config jest.ci.config.js",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts' 'cli/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'cli/**/*.ts' 'tests/**/*.ts'",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaun0927/opensafari.git"
  },
  "homepage": "https://github.com/shaun0927/opensafari#readme",
  "bugs": {
    "url": "https://github.com/shaun0927/opensafari/issues"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "!dist/src/",
    "!dist/node_modules/",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "safari",
    "ios",
    "simulator",
    "mcp",
    "webkit",
    "automation",
    "testing",
    "xcode",
    "mobile",
    "qa"
  ],
  "dependencies": {
    "commander": "^12.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^6.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/pngjs": "^6.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2",
    "webpack-node-externals": "^3.0.0"
  }
}
